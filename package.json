{
  "name": "ocrowley-commons",
  "private": true,
  "version": "0.1.0",
  "description": "Shared library foundation for ocrowleymatt-stack",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bash scripts/build-workspaces.sh",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:ai-client": "npm run test -w @ocrowley/ai-client",
    "test:intent": "npm run test -w @ocrowley/intent",
    "who:server": "npm run who:server -w @ocrowley/osint",
    "who:worker": "npm run who:worker -w @ocrowley/osint",
    "bb:bridge": "PYTHONPATH=python/ocrowley_osint python3 -m ocrowley_osint --port 8798",
    "who:smoke": "bash packages/osint/scripts/who-smoke.sh",
    "who:up": "docker compose -f deploy/who/docker-compose.yml --env-file deploy/who/.env up -d --build",
    "who:down": "docker compose -f deploy/who/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "~5.8.2",
    "tsx": "^4.21.0",
    "@types/node": "^22.14.0"
  }
}
