# Required — case auth (default-deny without this)
OCROWLEY_OSINT_CASE=CASE-PROD-1

# UI/API access PIN (default 3123)
OCROWLEY_WHO_PIN=3123

# Auth mode: pin | operators | pin+operators
# operators → require X-OCROWLEY-WHO-TOKEN (Bearer who_…); bootstraps admin token on first start
OCROWLEY_WHO_AUTH=pin
# Optional seed token when bootstrapping operators mode
# OCROWLEY_WHO_BOOTSTRAP_TOKEN=who_your_long_random_token
# Or JSON list: [{"id":"op1","token":"who_…","roles":["osint-operator"],"cases":["*"]}]
# OCROWLEY_WHO_OPERATORS=

# Public port on the host
OCROWLEY_WHO_PUBLISH_PORT=8787

# Bridges (defaults match private stack)
OCROWLEY_SPIDERDASH_URL=https://spiderdash-mbpjlxnq.manus.space
OCROWLEY_SPIDERFOOT_URL=http://165.227.237.155:5001
OCROWLEY_BRIDGE_TIMEOUT_MS=180000
OCROWLEY_OSINT_DEEP=1

# Optional enrichment keys (leave blank if unused)
HIBP_API_KEY=
COMPANIES_HOUSE_API_KEY=
DEHASHED_API_KEY=
DEHASHED_EMAIL=
INTELX_API_KEY=

# CLI bridges (sherlock/maigret/holehe) — off in containers by default
OCROWLEY_ENABLE_CLI_TOOLS=0

# Async job worker inside the who container (POST /api/who/jobs)
OCROWLEY_WHO_WORKER=1
# Lease TTL for multi-worker reclaim (ms)
OCROWLEY_WHO_LEASE_MS=90000

# Optional AES-256-GCM at-rest encryption for dossiers (64 hex chars)
# ENCRYPTION_MASTER_KEY=
